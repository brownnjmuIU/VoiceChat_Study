# Copy to .env for local dev. Never commit .env.

# --- Text model: IU REALLMS (OpenAI-compatible) ---
LLM_BASE_URL=https://reallms.rescloud.iu.edu/direct/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss-120b
LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=1024   (default 1024; the endpoint is public, keep a cap)
# LLM_TEMPERATURE=
# LLM_MOCK=1            # canned replies, no key or STUDY_TOKEN needed

# --- Access (required with a real LLM) ---
# Shared secret in the study link (?k=<token>). Use the same value in qualtrics/question.js.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
STUDY_TOKEN=

# --- Voice ---
# browser = the device's own voice via speechSynthesis (default; instant, no server load)
# kokoro = Kokoro-82M inside this server (open weights, but ~1.3-4x slower than real time on a laptop CPU)
# openai = any OpenAI-compatible /v1/audio/speech (OpenAI, or Kokoro-FastAPI on IU hardware)
# mock   = a beep, for UI work without the model
TTS_BACKEND=browser
# TTS_BROWSER_VOICE=      # browser backend: preferred voice name (substring), e.g. Aria or Samantha
TTS_VOICE=af_heart
TTS_SPEED=1
# KOKORO_DTYPE=q8       # q8 (default, ~90 MB), q4 (smaller, lower quality), fp32 (best, ~330 MB)
# MODEL_CACHE_DIR=./.model-cache
# TTS_BASE_URL=http://localhost:8880/v1
# TTS_API_KEY=
# TTS_MODEL=kokoro

# --- Study UI ---
DEFAULT_MODE=voice      # text | voice; ?mode= in the URL overrides per page load
SHOW_TRANSCRIPT=false   # voice mode: also show the words? ?transcript=1 overrides
# CHAT_TITLE=Assistant
# SYSTEM_PROMPT=        # same prompt for BOTH conditions; default is the privacy-policy helper in src/config.js

# --- Study data: Supabase (one project for this study) ---
# Required. The server refuses to boot without these unless STORE_DISABLED=1.
SUPABASE_URL=            # https://<project>.supabase.co  (no /rest/v1 needed)
SUPABASE_SERVICE_KEY=    # service_role / secret key. Server only. Never commit.
# STORE_DISABLED=1       # local dev without a database (data is NOT saved)
# SUPABASE_KEEPALIVE_HOURS=6
# APP_VERSION=           # Render fills this from RENDER_GIT_COMMIT

# --- Study behaviour ---
# MAX_HISTORY_MESSAGES=200   # most messages the browser may send per request
# LLM_CONTEXT_MESSAGES=40    # only the most recent N go to the model (also capped at 40,000 chars total)
# POLICY_DIR=./policies      # privacy policy text appended to the prompt
# SHOW_RESET=false           # hide "New chat" during the study
PARENT_ORIGINS=https://iu.co1.qualtrics.com

# --- Framing ---
# FRAME_ANCESTORS='self' https://*.qualtrics.com   who may iframe the page
