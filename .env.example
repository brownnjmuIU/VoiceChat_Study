# Copy to .env for local dev. Never commit .env.

# --- Text model: IU REALLMS (OpenAI-compatible) ---
LLM_BASE_URL=https://reallms.rescloud.iu.edu/direct/v1
LLM_API_KEY=
LLM_MODEL=gpt-oss-120b
LLM_REASONING_EFFORT=low
# LLM_MAX_TOKENS=
# LLM_TEMPERATURE=
# LLM_MOCK=1            # canned replies, no key needed

# --- Voice ---
# browser = the device's own voice via speechSynthesis (default; instant, no server load)
# kokoro = Kokoro-82M inside this server (open weights, but ~1.3-4x slower than real time on a laptop CPU)
# openai = any OpenAI-compatible /v1/audio/speech (OpenAI, or Kokoro-FastAPI on IU hardware)
# mock   = a beep, for UI work without the model
TTS_BACKEND=browser
# TTS_BROWSER_VOICE=      # browser backend: preferred voice name (substring), e.g. Aria or Samantha
TTS_VOICE=af_heart
TTS_SPEED=1
# KOKORO_DTYPE=q8       # q8 (default, ~90 MB), q4 (smaller, lower quality), fp32 (best, ~330 MB)
# MODEL_CACHE_DIR=./.model-cache
# TTS_BASE_URL=http://localhost:8880/v1
# TTS_API_KEY=
# TTS_MODEL=kokoro

# --- Study UI ---
DEFAULT_MODE=voice      # text | voice; ?mode= in the URL overrides per page load
SHOW_TRANSCRIPT=false   # voice mode: also show the words? ?transcript=1 overrides
# CHAT_TITLE=Assistant
# SYSTEM_PROMPT=        # same prompt is used for BOTH conditions
